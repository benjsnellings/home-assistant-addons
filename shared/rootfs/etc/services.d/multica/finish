#!/command/with-contenv bash
# Restart Multica if it exits non-cleanly. Exit 0 tells s6-overlay legacy
# services.d to bring the service back up.
exit_code="${1:-0}"
if [[ "${exit_code}" -eq 256 ]]; then
  exit_code=$((128 + ${2:-0}))
fi
if [[ "${exit_code}" -ne 0 ]]; then
  echo "[multica] service exited ${exit_code}; restarting in 5s"
  sleep 5
fi
exit 0
