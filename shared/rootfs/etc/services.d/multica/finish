#!/command/with-contenv bash
# s6-overlay legacy services.d: exit 0 from finish => restart service;
# non-zero => do not restart.
#
# Restart only on unexpected crashes. Permanent config/auth failures use
# exit 78 (EX_CONFIG) from /run.sh and must not loop.
exit_code="${1:-0}"
if [[ "${exit_code}" -eq 256 ]]; then
  exit_code=$((128 + ${2:-0}))
fi

if [[ "${exit_code}" -eq 0 ]]; then
  echo "[multica] clean exit; not auto-restarting (Supervisor owns lifecycle)"
  exit 1
fi

if [[ "${exit_code}" -eq 78 ]]; then
  echo "[multica] configuration/auth failure (exit 78); not restarting — fix add-on options and restart"
  exit 1
fi

echo "[multica] service crashed with exit ${exit_code}; restarting in 5s"
sleep 5
exit 0
